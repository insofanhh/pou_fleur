MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fleur_store
MYSQL_SSL=false
APP_ORIGIN=http://127.0.0.1:3000
ADMIN_EMAIL=admin@fleur.local
ADMIN_PASSWORD=replace-with-a-strong-password

# Gmail: enable 2-Step Verification and use an App Password, not your login password.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Fleur
CRON_SECRET=

# Optional locally; connect a public Blob store on Vercel. Never use NEXT_PUBLIC_.
BLD_STORE_ID=
BLD_READ_WRITE_TOKEN=

# SaaS integrations. Google callback: APP_ORIGIN/api/auth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# REST key stays on the server; Maptiles key is public and should be domain-restricted.
# Copy these into .env.local for development and Vercel Environment Variables for production.
# Restart next dev after changes; production needs a new build for NEXT_PUBLIC_* values.
GOONG_API_KEY=
NEXT_PUBLIC_GOONG_MAPTILES_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Disable new manual-order creation/drafts without hiding existing order operations.
MANUAL_ORDERS_ENABLED=true
